{
    "info": {
        "_postman_id": "mydogsvisits-api-collection",
        "name": "MyDogsVisits API",
        "description": "Kolekcja testowa Postman dla backendu aplikacji MyDogsVisits (Laravel + Redis + Sanctum).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost/api",
            "type": "string"
        },
        {
            "key": "bearerToken",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "System",
            "item": [
                {
                    "name": "Ping / Test CORS",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/ping",
                            "host": ["{{baseUrl}}"],
                            "path": ["ping"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Autoryzacja (Auth)",
            "item": [
                {
                    "name": "Rejestracja",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.collectionVariables.set('bearerToken', jsonData.token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Jan Kowalski\",\n    \"email\": \"jan@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/register",
                            "host": ["{{baseUrl}}"],
                            "path": ["register"]
                        }
                    }
                },
                {
                    "name": "Logowanie",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.collectionVariables.set('bearerToken', jsonData.token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"jan@example.com\",\n    \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/login",
                            "host": ["{{baseUrl}}"],
                            "path": ["login"]
                        }
                    }
                },
                {
                    "name": "Wylogowanie",
                    "request": {
                        "auth": {
                            "type": "bearer",
